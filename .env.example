ALLOW_CLOUD_AI=false
OPENROUTER_API_KEY=
DRAFT_MODEL=google/gemini-2.5-flash
PORT=4000
# Optional: separate models for the click planner and the supervisor (default to DRAFT_MODEL)
EXPLORE_MODEL=
REVIEW_MODEL=
# The guide-level supervisor (decides approve/reject/reshoot/explore, powers the chat). A stronger model is worth it here.
SUPERVISOR_MODEL=
# Max tool-call steps per assistant request (default 25). The model must support tool calling.
SUPERVISOR_MAX_STEPS=25
EXPLORE_MAX=4
